created:
    - app/Http/Controllers/PostController.php
    - database/factories/CategoryFactory.php
    - database/factories/PostFactory.php
    - database/factories/InteractionFactory.php
    - database/migrations/2026_03_08_151123_create_categories_table.php
    - database/migrations/2026_03_08_151124_create_posts_table.php
    - database/migrations/2026_03_08_151125_create_interactions_table.php
    - database/migrations/2026_03_08_151126_create_post_user_table.php
    - app/Models/Category.php
    - app/Models/Post.php
    - app/Models/Interaction.php
    - database/seeders/CategorySeeder.php
    - database/seeders/PostSeeder.php
    - database/seeders/InteractionSeeder.php
    - tests/Feature/Http/Controllers/PostControllerTest.php
    - resources/views/post/index.blade.php
    - resources/views/post/show.blade.php
updated:
    - routes/web.php
models:
    User:
        name: string
        email: string unique
        email_verified_at: timestamp nullable
        password: string
        remember_token: string nullable
        new_account: boolean default:true
        relationships:
            hasMany:
                - Interaction
                - Interest
            belongsToMany:
                - Category through: interests withPivot: [weight]
                - Post
    Category:
        name: string
        slug: string
        relationships:
            belongsToMany:
                - User through: interests withPivot: [weight]
                - Post through: category_post
    Post:
        title: string
        content: longtext
        image_url: string nullable
        published_at: timestamp nullable
        relationships:
            hasMany:
                - Interaction
            belongsToMany:
                - Category through: category_post
                - User
    Interaction:
        user_id: id foreign
        post_id: id foreign
        interaction_type: string
        weight: integer default:1
        timestamps: timestamps
        relationships:
            belongsTo:
                - User
                - Post
    Interest:
        user_id: id foreign
        category_id: id foreign
        weight: decimal(3,1) default:0
        timestamps: timestamps
        relationships:
            belongsTo:
                - User
                - Category
